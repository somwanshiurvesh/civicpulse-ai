# ==============================================================================
# CivicPulse AI - Shared Environment Variables Template
# Copy this file to '.env' and adjust values for local development.
# ==============================================================================

# Core API server configurations
PORT=5000

# Database configurations (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=civicpulse

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Internal Microservices (AI / ML Worker)
AI_SERVICE_URL=http://localhost:5001
